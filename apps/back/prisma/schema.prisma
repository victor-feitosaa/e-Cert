generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  name       String?
  email      String     @unique
  password   String
  cpf        String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  systemRole SystemRole @default(USER)
  status     Status     @default(ACTIVE)

  events              Event[]           @relation("EventCreator")
  subEvents           SubEvent[]        @relation("SubEventCreator")
  eventTeam           EventTeam[]
  subEventTeam        SubEventTeam[]
  grantedPermissions  EventPermission[] @relation("Granter")
  receveidPermissions EventPermission[] @relation("GrantedUser")
  eventParticipations EventParticipant[]
  subEventParticipations SubeventParticipant[]
  sectionParticipations SectionParticipant[]
  eventAttendances    EventAttendance[]
  sectionAttendances  SectionAttendance[]
  certificates        Certificate[]
}

model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  date        DateTime
  date_start  DateTime?
  date_end    DateTime?
  banner      String?
  category    String?
  capacity    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  location    String?
  isPublic    Boolean   @default(true)

  attendances EventAttendance[]

  createdBy        String
  creator          User              @relation("EventCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  subEvents        SubEvent[]
  eventTeam        EventTeam[]
  eventPermissions EventPermission[]
  participants     EventParticipant[]
  certificates     Certificate[]
}

model SubEvent {
  id          String    @id @default(uuid())
  title       String
  description String
  date        DateTime?
  date_start  DateTime?
  date_end    DateTime?
  location    String?
  capacity    Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy String
  eventId   String

  creator      User                  @relation("SubEventCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sections     Section[]
  team         SubEventTeam[]
  participants SubeventParticipant[]
  certificates Certificate[]
}

model Section {
  id         String   @id @default(uuid())
  title      String?
  date_start DateTime
  date_end   DateTime
  location   String?
  capacity   Int?
  subEventId String
  subEvent   SubEvent @relation(fields: [subEventId], references: [id], onDelete: Cascade)

  participants SectionParticipant[]
  attendances SectionAttendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subEventId])
}


model SectionParticipant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  sectionId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])  
  @@index([sectionId])
  @@index([userId])
}

// ── Participantes ─────────────────────────────────────────────────────────────
// Substituído name+email soltos por userId — inscrição sempre exige conta

model EventParticipant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])   // impede inscrição duplicada no banco
  @@index([eventId])
  @@index([userId])
}

model SubeventParticipant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId     String
  subEventId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subEvent SubEvent @relation(fields: [subEventId], references: [id], onDelete: Cascade)

  @@unique([userId, subEventId])
  @@index([subEventId])
  @@index([userId])
}

// Confirmação de presença e emissão de certificado dependem de participação registrada, não de inscrição — evita confusão entre inscritos e participantes efetivos

model EventAttendance {
  id        String   @id @default(uuid())
  attended   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  eventId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])  
  @@index([eventId])
  @@index([userId])
}

model SectionAttendance {
  id        String   @id @default(uuid())
  attended   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  sectionId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])  
  @@index([sectionId])
  @@index([userId])
}

// ── Certificados ──────────────────────────────────────────────────────────────

model Certificate {
  id           String   @id @default(uuid())
  userId       String
  eventId      String?
  subEventId   String?
  participantId String? 
  issueDate    DateTime @default(now())
  workload     String   
  type         String   @default("Participante") 
  hash         String   @unique // JWT assinado
  issued       Boolean  @default(false) // Controle de envio por e-mail

  // Relações
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  subEvent  SubEvent? @relation(fields: [subEventId], references: [id], onDelete: Cascade)

  // Garante que não haja duplicidade para o mesmo usuário/evento
  @@unique([userId, eventId])
  @@unique([userId, subEventId])
}

// ── Permissões ────────────────────────────────────────────────────────────────

enum Status {
  ACTIVE
  INATIVE
  PARCIAL
}

enum SystemRole {
  ADMIN
  MODERATOR
  USER
}

enum EventRole {
  ORGANIZER
  MODERATOR
  CHECKIN
  MEMBER
  ATTENDEE
}

model EventPermission {
  id        String    @id @default(uuid())
  userId    String
  eventId   String
  role      EventRole
  grantedBy String
  grantedAt DateTime  @default(now())
  expiresAt DateTime?

  user    User  @relation("GrantedUser", fields: [userId], references: [id], onDelete: Cascade)
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  granter User  @relation("Granter", fields: [grantedBy], references: [id])

  @@unique([userId, eventId])
  @@map("event_permissions")
}

// ── Equipes ───────────────────────────────────────────────────────────────────

model EventTeam {
  id   String      @id @default(uuid())
  name String
  job  String
  role SystemRole?

  userId  String
  eventId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_teams")
}

model SubEventTeam {
  id   String      @id @default(uuid())
  name String
  job  String
  role SystemRole?

  userId     String
  subEventId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  subEvent SubEvent @relation(fields: [subEventId], references: [id], onDelete: Cascade)

  @@map("sub_event_teams")
}