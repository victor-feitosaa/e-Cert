---
import Layout from "../../layouts/Layout.astro";
import CertificateVerify from "@/components/CertificateVerify.jsx";

export const prerender = false;

// Obtém o hash da URL
const { hash } = Astro.params;
---

<Layout title="Verificar Certificado — e-cert">
  <CertificateVerify client:load initialResult={null} hash={hash || null} />
</Layout>